# Copy to .env for local docker-compose overrides (optional)

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce

JWT_SECRET=change-me-to-at-least-32-chars-long-secret-key!!
JWT_EXPIRATION_MS=3600000

# Inter-service: order -> product internal APIs
SERVICE_INTERNAL_TOKEN=internal-service-shared-secret-change-me

# Gateway: trusted callers skip Redis rate limit (never expose to browser)
GATEWAY_INTERNAL_BYPASS_SECRET=gateway-bypass-secret-change-me

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-server:8761/eureka/
